// pkcs12_refusal_tests.nv — what the PFX reader refuses, with crafted structures.
//
// The pieces are small DER structures written out in the test; the key
// bag of the "pkcs8_ec" vector comes from the other suite.

use std.test
use std.bytes
use std.list
use cmserr
use cmsoid
use cmsder
use cmsinfo
use p12kdf
use p12pbe
use pkcs12

fn said<T>(r: Result<T, CmsError>) -> Str
    match r
        Ok(_)  => "ok"
        Err(e) => e.message()

fn h(s: Str) -> Bytes
    bytes.from_hex(s) ?? bytes.zeros(0)

fn hex(b: Bytes) -> Str
    bytes.to_hex(b)

fn must(r: Result<Bytes, CmsError>) -> Bytes
    match r
        Ok(b)  => bytes.clone(b)
        Err(e) =>
            test.fail(e.message())
            bytes.zeros(0)

fn t(tag: Int, body: Str) -> Str
    hex(cmsder.tlv(tag, h(body)))

fn oidh(text: Str) -> Str
    hex(must(cmsder.oid(text)))

fn algh(text: Str) -> Str
    t(48, oidh(text))

fn algp(text: Str, params: Str) -> Str
    t(48, oidh(text) + params)

fn inth(n: Int) -> Str
    hex(cmsder.int_u(n))

fn octh(body: Str) -> Str
    t(4, body)

fn zeros(n: Int) -> Str
    hex(bytes.zeros(n))

fn read_ok(src: Str, password: Str) -> Pfx
    match pkcs12.read(h(src), password, 100000, true)
        Ok(p)  => p
        Err(e) =>
            test.fail(e.message())
            Pfx { version: 0, safes: [], mac_present: false, mac_hash: "", mac_iterations: 0 }

fn derived(hash: Str, id: Int, password: Str, salt: Str, it: Int, n: Int) -> Str
    match p12kdf.bmp_password(password)
        Err(e)  => e.message()
        Ok(bmp) =>
            match p12kdf.derive(hash, id, bmp, h(salt), it, n)
                Ok(b)  => hex(b)
                Err(e) => e.message()

// A PFX without a MAC around the given AuthenticatedSafe members.
fn bare_pfx(safes: Str) -> Str
    t(48, inth(3) + hex(must(cmsinfo.write(OID_DATA, cmsder.oct(h(t(48, safes)))))))

// A data safe holding the given SafeBags.
fn data_safe(bags: Str) -> Str
    hex(must(cmsinfo.write(OID_DATA, cmsder.oct(h(t(48, bags))))))

fn bag(id: Str, value: Str, attrs: Str) -> Str
    t(48, oidh(id) + t(160, value) + attrs)

fn read_bare(safes: Str) -> Str
    said(pkcs12.read(h(bare_pfx(safes)), "pw", 100000, false))

fn modern() -> Str
    ""

fn des3() -> Str
    ""

fn rc2() -> Str
    ""

fn pkcs8_ec() -> Str
    "308187020100301306072a8648ce3d020106082a8648ce3d030107046d306b020101042032383af9d7c4b0f918a2c374bbbc277d537a383d959b9135070382d7bfb15230a14403420004572e9238470c66a216ac0e3162c59f5dbb2b4de4632f4f37c5490ebebfb5cb60e1aa3f7f826ecf8ce3a298ea38c611749c5dff7b3a7705d9bf3622cf6d11635d"

fn cert_ec() -> Str
    ""

fn cert_rsa() -> Str
    ""

fn pfx_with(version: Int, safes: Str, tail: Str) -> Str
    t(48, inth(version) + hex(must(cmsinfo.write(OID_DATA, cmsder.oct(h(t(48, safes)))))) + tail)

fn mac_data(hash: Str, iterations: Int) -> Str
    t(48, t(48, algh(hash) + octh(zeros(20))) + octh(zeros(8)) + inth(iterations))

// An encrypted-data safe from its algorithm identifier and ciphertext.
fn enc_safe(alg: Str) -> Str
    hex(must(cmsinfo.write(OID_ENCRYPTED_DATA, cmsder.seq([cmsder.int_u(0),
        cmsder.seq([must(cmsder.oid(OID_DATA)), h(alg), cmsder.ctx_prim(0, bytes.zeros(32))])]))))

fn pbes2(kdf: Str, scheme: Str) -> Str
    algp(p12pbe.OID_PBES2, t(48, kdf + scheme))

fn pbkdf2(params: Str) -> Str
    algp(OID_PBKDF2, params)

fn std_salt() -> Str
    octh(zeros(8))

fn cipher128() -> Str
    algp(OID_AES128_CBC, octh(zeros(16)))

fn enc_said(alg: Str) -> Str
    read_bare(enc_safe(alg))

@test
fn test_password_based_encryption_refusals() [io]
    let ok_kdf = pbkdf2(t(48, std_salt() + inth(1000)))
    test.case("the shape of PBES2")
    test.assert_eq_str(enc_said(algh(p12pbe.OID_PBES2)), "cms: malformed structure: the PBES2 parameters")
    test.assert_eq_str(enc_said(pbes2(algh("1.2.3"), cipher128())), "cms: algorithm 1.2.3 is not implemented")
    test.assert_eq_str(enc_said(pbes2(algh(OID_PBKDF2), cipher128())),
        "cms: malformed structure: the PBKDF2 parameters")
    test.assert_eq_str(enc_said(pbes2(ok_kdf, algh(OID_AES128_CBC))),
        "cms: malformed structure: the cipher parameters")
    test.case("the cipher and the pseudorandom function")
    test.assert_eq_str(enc_said(pbes2(ok_kdf, algp("1.2.3", octh(zeros(16))))),
        "cms: algorithm 1.2.3 is not implemented")
    test.assert_eq_str(enc_said(pbes2(pbkdf2(t(48, std_salt() + inth(1000) + inth(24) + algp(OID_HMAC_SHA512, "0500"))),
        algp(OID_AES192_CBC, octh(zeros(16))))),
        "cms: the signature, digest or tag did not verify")
    test.assert_eq_str(enc_said(pbes2(pbkdf2(t(48, std_salt() + inth(1000) + algp(OID_HMAC_SHA1, "0500"))), cipher128())),
        "cms: the signature, digest or tag did not verify")
    test.assert_eq_str(enc_said(pbes2(pbkdf2(t(48, std_salt() + inth(1000) + algp("1.2.3", "0500"))), cipher128())),
        "cms: algorithm 1.2.3 is not implemented")
    test.case("the iteration count, bounded by the caller")
    test.assert_eq_str(enc_said(pbes2(pbkdf2(t(48, std_salt() + inth(0))), cipher128())),
        "cms: unusable key: the iteration count is 0, the limit is 100000")
    test.assert_eq_str(enc_said(pbes2(pbkdf2(t(48, std_salt() + inth(100001))), cipher128())),
        "cms: unusable key: the iteration count is 100001, the limit is 100000")
    test.case("a legacy scheme asked to decrypt directly")
    match cmsder.root(h(algh("1.2.840.113549.1.12.1.3")))
        Err(e)   => test.fail(e.message())
        Ok(node) =>
            match p12pbe.read(node)
                Err(e)  => test.fail(e.message())
                Ok(pbe) =>
                    test.assert_eq_str(said(p12pbe.decrypt(pbe, "pw", 100, bytes.zeros(32))),
                        "cms: not implemented: the password-based encryption 1.2.840.113549.1.12.1.3: TripleDES and RC2 are not on the registry")
    test.case("encrypting with a count of zero and a short salt")
    test.assert_eq_str(said(p12pbe.encrypt("pw", h("0102030405060708"), 0, bytes.zeros(16), bytes.zeros(1))),
        "cms: unusable key: pbkdf2: 0 is not a positive count")
    test.assert_eq_str(said(p12pbe.encrypt("pw", h("01"), 1000, bytes.zeros(16), bytes.zeros(1))),
        "cms: unusable key: the salt is at least 8 bytes")

fn nested_key_bag() -> Str
    bag(OID_KEY_BAG, pkcs8_ec(), "")

@test
fn test_bag_kinds_and_shapes() [io]
    let secret = bag(OID_SECRET_BAG, t(48, oidh("1.2.3") + t(160, octh("aa"))), "")
    let crl = bag(OID_CRL_BAG, t(48, oidh(OID_X509_CRL) + t(160, octh("3000"))), "")
    let nested = bag(OID_SAFE_CONTENTS_BAG, t(48, nested_key_bag()), "")
    let sdsi = bag(OID_CERT_BAG, t(48, oidh(OID_SDSI_CERTIFICATE) + t(160, octh("aabb"))), "")
    let other = bag("1.2.3", "0500", "")
    let pfx = read_ok_bare(data_safe(secret + crl + nested + sdsi + other + nested_key_bag()))
    test.assert_eq(list.len(pfx.safes[0].bags), 6)
    test.assert_eq(list.len(pkcs12.bags_of_kind(pfx, KIND_SECRET)), 1)
    test.assert_eq_str(pkcs12.bags_of_kind(pfx, KIND_SECRET)[0].value_id, "1.2.3")
    test.assert_eq_str(hex(pkcs12.bags_of_kind(pfx, KIND_SECRET)[0].value), "0401aa")
    test.assert_eq_str(hex(pkcs12.bags_of_kind(pfx, KIND_CRL)[0].value), "3000")
    test.assert_eq(list.len(pkcs12.bags_of_kind(pfx, KIND_OTHER)), 1)
    test.case("an SDSI certificate is handed out as its octets and is not an X.509 certificate")
    test.assert_eq_str(hex(pkcs12.bags_of_kind(pfx, KIND_CERT)[0].value), "aabb")
    test.assert_eq(list.len(pkcs12.certificates(pfx)), 0)
    test.case("a key bag in the clear")
    test.assert_eq(list.len(pkcs12.private_keys(pfx)), 1)
    test.assert_eq_str(hex(pkcs12.private_keys(pfx)[0]), pkcs8_ec())
    test.case("a safe-contents bag holds bags")
    let holder = pkcs12.bags_of_kind(pfx, KIND_SAFE_CONTENTS)[0]
    match pkcs12.bags_in(holder, "pw", 100)
        Err(e)   => test.fail(e.message())
        Ok(bags) =>
            test.assert_eq(list.len(bags), 1)
            test.assert_eq(bags[0].kind, KIND_KEY)
    test.assert_eq_str(said(pkcs12.bags_in(pkcs12.bags_of_kind(pfx, KIND_KEY)[0], "pw", 100)),
        "cms: malformed structure: only a safe-contents bag holds bags")

fn read_ok_bare(safes: Str) -> Pfx
    match pkcs12.read(h(bare_pfx(safes)), "pw", 100000, false)
        Ok(p)  => p
        Err(e) =>
            test.fail(e.message())
            Pfx { version: 0, safes: [], mac_present: false, mac_hash: "", mac_iterations: 0 }

@test
fn test_pfx_refusals() [io]
    test.assert_eq_str(read_bare(data_safe(bag(OID_KEY_BAG, pkcs8_ec(), ""))), "ok")
    test.assert_eq_str(read_bare(data_safe(t(48, oidh(OID_KEY_BAG) + "0500"))),
        "cms: malformed structure: the bag value is under [0]")
    test.assert_eq_str(read_bare(hex(must(cmsinfo.write(OID_SIGNED_DATA, h("3000"))))),
        "cms: content type 1.2.840.113549.1.7.2 where data or encrypted-data was expected")
    test.assert_eq_str(said(pkcs12.read(h(pfx_with(2, "", "")), "pw", 100, false)),
        "cms: malformed structure: the PFX version is 2, only 3 is defined")
    test.assert_eq_str(said(pkcs12.read(h(bare_pfx("")), "pw", 100, true)), "cms: no match: a MAC in the PFX")
    test.assert_eq_str(said(pkcs12.read(h(bare_pfx("")), "pw", 100, false)), "ok")
    test.assert_eq_str(said(pkcs12.read(h("0500"), "pw", 100, false)),
        "cms: malformed structure: the PFX is not the expected type")
    test.case("the MAC's hash and iteration count")
    for hash in [OID_SHA384, OID_SHA512, OID_SHA1, OID_SHA256]
        test.assert_eq_str(said(pkcs12.read(h(pfx_with(3, "", mac_data(hash, 2))), "pw", 100, true)),
            "cms: the signature, digest or tag did not verify")
    test.assert_eq_str(said(pkcs12.read(h(pfx_with(3, "", mac_data("1.2.3", 2))), "pw", 100, true)),
        "cms: algorithm 1.2.3 is not implemented")
    test.assert_eq_str(said(pkcs12.read(h(pfx_with(3, "", mac_data(OID_SHA1, 0))), "pw", 100, true)),
        "cms: unusable key: the MAC iteration count is 0, the limit is 100")
    test.assert_eq_str(said(pkcs12.read(h(pfx_with(3, "", t(48, t(48, algh(OID_SHA1) + octh(zeros(20))) + octh(zeros(8))))),
        "pw",
        100,
        true)),
        "cms: the signature, digest or tag did not verify")
    test.assert_eq_str(said(pkcs12.read(h(pfx_with(3, "", mac_data(OID_SHA1, 2))), bytes.to_str(h("ff")), 100, true)),
        "cms: malformed structure: the text is not well-formed UTF-8")

@test
fn test_the_smaller_functions_by_name() [io]
    let salt = h("0102030405060708")
    match p12pbe.alg_id(salt, 1000, bytes.zeros(16))
        Err(e)  => test.fail(e.message())
        Ok(alg) =>
            match cmsder.root(alg)
                Err(e)   => test.fail(e.message())
                Ok(node) =>
                    match p12pbe.read(node)
                        Err(e)  => test.fail(e.message())
                        Ok(pbe) =>
                            test.assert_eq_str(pbe.oid, p12pbe.OID_PBES2)
                            test.assert_eq_str(pbe.cipher, OID_AES256_CBC)
                            test.assert_eq_str(pbe.prf, OID_HMAC_SHA256)
                            test.assert_eq(pbe.iterations, 1000)
    match pkcs12.mac_of(OID_SHA256, "pw", salt, 2, h("00"))
        Ok(a)  =>
            test.assert_eq(bytes.len(a), 32)
            match pkcs12.mac_of(OID_SHA1, "pw", salt, 2, h("00"))
                Ok(b)  => test.assert_eq(bytes.len(b), 20)
                Err(e) => test.fail(e.message())
        Err(e) => test.fail(e.message())
